# ESP32-C6 DIAMANT v2.1 SDK Configuration Defaults

#
# HTTP Server Configuration
#
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=y

#
# I2C Configuration
#
CONFIG_I2C_ENABLE_DEBUG_LOG=n

#
# Console Configuration
#
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_USB_CDC_SUPPORT_ETS_PRINTF=n

#
# WiFi Configuration
#
CONFIG_ESP_WIFI_SSID="DIAMANT"
CONFIG_ESP_WIFI_PASSWORD="diamant2024"
CONFIG_ESP_MAXIMUM_RETRY=5
CONFIG_ESP_WIFI_AUTH_WPA2_PSK=y
CONFIG_ESP_WIFI_AUTH_OPEN=n
CONFIG_ESP_WIFI_AUTH_WEP=n
CONFIG_ESP_WIFI_AUTH_WPA_PSK=n
CONFIG_ESP_WIFI_AUTH_WPA_WPA2_PSK=n
CONFIG_ESP_WIFI_AUTH_WPA3_PSK=n
CONFIG_ESP_WIFI_AUTH_WPA2_WPA3_PSK=n
CONFIG_ESP_WIFI_AUTH_WAPI_PSK=n

#
# FreeRTOS Configuration
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

#
# Logging Configuration
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL=5

#
# Partition Table
#
CONFIG_PARTITION_TABLE_SINGLE_APP=y

#
# ESP System Settings
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

#
# LWIP Configuration
#
CONFIG_LWIP_LOCAL_HOSTNAME="diamant-v2"

#
# mbedTLS Configuration
#
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y

#
# NVS Configuration
#
CONFIG_NVS_ENCRYPTION=n
